{
	email {$ACME_EMAIL}
	servers {
		# HTTP/1.1 et HTTP/2 (TCP) seulement. Sur iPhone (iOS 26), HTTP/3 (QUIC)
		# et sa reprise de session « 0-RTT » ont des ratés connus : une requête
		# envoyée après une pause peut échouer avant d'atteindre l'appli. Pour
		# une appli familiale, HTTP/2 est tout aussi rapide.
		protocols h1 h2
	}
}

{$DOMAIN} {
	encode zstd gzip
	# Une ligne par requête (./deploy/compose.sh logs caddy) : montre si une
	# requête est bien arrivée jusqu'au VPS, et ce que Caddy a répondu. Les
	# en-têtes de connexion (Authorization, cookies) sont masqués par Caddy.
	log {
		output stdout
		format json
	}
	# L'appli (nginx) relaie elle-même /api et /ws vers le serveur.
	reverse_proxy client:80
}
